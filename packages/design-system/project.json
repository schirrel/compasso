{
  "name": "@compasso/design-system",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "packages/design-system/src",
  "tags": [
    "scope:shared",
    "type:ui"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": [
        "{projectRoot}/dist"
      ],
      "options": {
        "cwd": "packages/design-system",
        "commands": [
          "vite build",
          "tsc -p tsconfig.lib.json"
        ],
        "parallel": false
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": true,
      "outputs": [
        "{projectRoot}/coverage"
      ],
      "options": {
        "cwd": "packages/design-system",
        "command": "vitest run"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "cwd": "packages/design-system",
        "command": "tsc -p tsconfig.json --noEmit"
      }
    },
    "playground": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": {
        "cwd": "packages/design-system",
        "command": "vite --config playground/vite.config.ts"
      }
    }
  }
}
